
<!DOCTYPE html>
<html>
<head>
<title>Train Reservation System</title>
<style>
body{font-family:Arial;background:#f1f5f9;margin:20px}
section{background:white;padding:15px;margin:15px 0;border-radius:8px}
input,select,button{padding:9px;margin:5px}
button{background:#245780;color:white;border:0;cursor:pointer}
table{width:100%;border-collapse:collapse}
td,th{padding:8px;border:1px solid #ddd;text-align:left}
</style>
</head>
<body>
<h1>Online Train Reservation System</h1>

<section>
<h2>Passenger Login</h2>
<input id="name" placeholder="Passenger name">
<input id="email" type="email" placeholder="Email">
<button onclick="login()">Login</button>
<p id="account"></p>
</section>

<section>
<h2>Search Trains</h2>
<input id="from" placeholder="Origin station">
<input id="to" placeholder="Destination station">
<input id="date" type="date">
<select id="classType">
<option>Sleeper</option><option>AC 3 Tier</option>
<option>AC 2 Tier</option><option>AC First Class</option>
</select>
<button onclick="searchTrains()">Search</button>
<div id="results"></div>
</section>

<section>
<h2>Passenger Details and Booking</h2>
<p id="selected"></p>
<input id="passenger" placeholder="Passenger full name">
<input id="age" type="number" placeholder="Age">
<select id="gender"><option>Female</option><option>Male</option><option>Other</option></select>
<select id="payment"><option>Online (Demo)</option><option>Offline (Demo)</option></select>
<button onclick="bookTicket()">Pay and Book Ticket</button>
<p id="message"></p>
</section>

<section>
<h2>Check PNR / Cancel Ticket</h2>
<input id="pnrInput" placeholder="Enter PNR">
<button onclick="checkPNR()">Check PNR</button>
<button onclick="cancelTicket()">Cancel Ticket</button>
<p id="pnrResult"></p>
</section>

<section>
<h2>My Tickets</h2>
<div id="history"></div>
</section>

<section>
<h2>Admin: Manage Trains</h2>
<input id="trainName" placeholder="Train name">
<input id="trainFrom" placeholder="From">
<input id="trainTo" placeholder="To">
<input id="trainFare" type="number" placeholder="Base fare">
<input id="trainSeats" type="number" placeholder="Available seats">
<button onclick="addTrain()">Add Train</button>
<div id="admin"></div>
</section>

<script>
let user=null,selectedTrain=null;
let trains=JSON.parse(localStorage.getItem("trains")||"[]");
let tickets=JSON.parse(localStorage.getItem("trainTickets")||"[]");

if(!trains.length){
 trains=[
 {id:1,name:"Chennai Express",from:"Chennai",to:"Bengaluru",fare:500,seats:40},
 {id:2,name:"Coastal Express",from:"Chennai",to:"Hyderabad",fare:650,seats:35},
 {id:3,name:"Intercity Express",from:"Bengaluru",to:"Mysuru",fare:300,seats:30}
 ];
 save();
}
function save(){
 localStorage.setItem("trains",JSON.stringify(trains));
 localStorage.setItem("trainTickets",JSON.stringify(tickets));
}
function v(id){return document.getElementById(id).value.trim()}
function login(){
 let name=v("name"),email=v("email");
 if(!name||!email)return alert("Enter name and email");
 user={name,email};
 document.getElementById("account").textContent="Logged in as "+name;
 showHistory();
}
function searchTrains(){
 let f=v("from").toLowerCase(),t=v("to").toLowerCase();
 let list=trains.filter(x=>
 (!f||x.from.toLowerCase().includes(f))&&
 (!t||x.to.toLowerCase().includes(t))&&x.seats>0);
 document.getElementById("results").innerHTML=
 "<table><tr><th>Train</th><th>Route</th><th>Fare</th><th>Seats</th><th></th></tr>"+
 list.map(x=>`<tr><td>${x.name}</td>
 <td>${x.from} to ${x.to}</td><td>Rs. ${x.fare}</td>
 <td>${x.seats}</td><td><button onclick="selectTrain(${x.id})">Select</button></td></tr>`).join("")+"</table>";
}
function selectTrain(id){
 selectedTrain=trains.find(x=>x.id===id);
 document.getElementById("selected").textContent=
 selectedTrain.name+" | "+selectedTrain.from+" to "+selectedTrain.to+
 " | Class: "+v("classType")+" | Fare: Rs. "+
 Math.round(selectedTrain.fare*classMultiplier());
}
function classMultiplier(){
 return {"Sleeper":1,"AC 3 Tier":1.5,"AC 2 Tier":2,
 "AC First Class":3}[v("classType")]||1;
}
function bookTicket(){
 if(!user)return alert("Login first");
 if(!selectedTrain)return alert("Search and select a train");
 let name=v("passenger"),age=Number(v("age"));
 if(!name||age<1||age>120)return alert("Enter valid passenger details");
 if(selectedTrain.seats<1)return alert("No seats available");
 let pnr=String(Math.floor(1000000000+Math.random()*9000000000));
 let fare=Math.round(selectedTrain.fare*classMultiplier());
 let ticket={
 pnr,user:user.email,owner:user.name,passenger:name,age,
 train:selectedTrain.name,trainId:selectedTrain.id,
 from:selectedTrain.from,to:selectedTrain.to,date:v("date")||"Not specified",
 classType:v("classType"),fare,payment:v("payment"),
 status:"Confirmed",refund:0
 };
 tickets.push(ticket);selectedTrain.seats--;save();
 document.getElementById("message").textContent=
 "Booking successful! PNR: "+pnr+" | Status: Confirmed | Fare: Rs. "+fare;
 showHistory();searchTrains();showAdmin();
}
function checkPNR(){
 let p=v("pnrInput");
 let t=tickets.find(x=>x.pnr===p);
 document.getElementById("pnrResult").textContent=t?
 "PNR: "+t.pnr+" | Train: "+t.train+" | Passenger: "+t.passenger+
 " | Status: "+t.status+" | Refund: Rs. "+t.refund:"PNR not found";
}
function cancelTicket(){
 let p=v("pnrInput");
 let t=tickets.find(x=>x.pnr===p&&x.user===user?.email&&x.status==="Confirmed");
 if(!t)return alert("Active ticket not found for your account");
 // Simplified demo refund: 80% of fare.
 t.status="Cancelled";t.refund=Math.round(t.fare*0.8);
 let train=trains.find(x=>x.id===t.trainId);
 if(train)train.seats++;
 save();showHistory();searchTrains();showAdmin();checkPNR();
 alert("Ticket cancelled. Demo refund: Rs. "+t.refund);
}
function showHistory(){
 if(!user)return;
 let list=tickets.filter(t=>t.user===user.email);
 document.getElementById("history").innerHTML=
 "<table><tr><th>PNR</th><th>Train</th><th>Passenger</th><th>Date</th><th>Class</th><th>Fare</th><th>Status</th></tr>"+
 list.map(t=>`<tr><td>${t.pnr}</td><td>${t.train}</td>
 <td>${t.passenger}</td><td>${t.date}</td><td>${t.classType}</td>
 <td>Rs. ${t.fare}</td><td>${t.status}</td></tr>`).join("")+"</table>";
}
function addTrain(){
 let name=v("trainName"),from=v("trainFrom"),to=v("trainTo");
 let fare=Number(v("trainFare")),seats=Number(v("trainSeats"));
 if(!name||!from||!to||fare<=0||seats<0)return alert("Enter valid details");
 trains.push({id:Date.now(),name,from,to,fare,seats});
 save();showAdmin();searchTrains();
}
function showAdmin(){
 document.getElementById("admin").innerHTML=
 "<table><tr><th>Train</th><th>Route</th><th>Fare</th><th>Seats</th></tr>"+
 trains.map(t=>`<tr><td>${t.name}</td><td>${t.from} to ${t.to}</td>
 <td>Rs. ${t.fare}</td><td>${t.seats}</td></tr>`).join("")+"</table>";
}
showAdmin();searchTrains();
</script>
</body>
</html>
